<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تسجيل الدخول</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#EDE7DA;
    --bg:#0E1B18;
    --bg-2:#132622;
    --panel:#16302B;
    --line:#2B4A42;
    --gold:#C9A24B;
    --gold-soft:#8E7A3F;
    --muted:#9FB0AA;
    --error:#D2705A;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    font-family:'Tajawal', sans-serif;
    background:
      radial-gradient(1200px 600px at 85% -10%, var(--bg-2), transparent 60%),
      var(--bg);
    color:var(--ink);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
  }

  .stage{
    width:100%;
    max-width:960px;
    display:grid;
    grid-template-columns:1.1fr 1fr;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:2px;
    overflow:hidden;
    min-height:560px;
  }

  /* Decorative side */
  .side{
    position:relative;
    padding:48px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    background:
      linear-gradient(180deg, rgba(201,162,75,.06), transparent 40%),
      var(--bg);
    border-left:1px solid var(--line);
  }
  .side::before{
    content:"";
    position:absolute;
    inset:32px;
    border:1px solid var(--gold-soft);
    opacity:.35;
    pointer-events:none;
  }
  .mark{
    font-family:'Amiri', serif;
    font-size:15px;
    letter-spacing:.5px;
    color:var(--gold);
  }
  .side h1{
    font-family:'Amiri', serif;
    font-weight:700;
    font-size:clamp(28px, 4vw, 40px);
    line-height:1.35;
    margin:0 0 12px;
    max-width:20ch;
  }
  .side p{
    color:var(--muted);
    font-size:15px;
    line-height:1.9;
    max-width:34ch;
    margin:0;
  }
  .side .foot{
    font-size:13px;
    color:var(--muted);
    border-top:1px solid var(--line);
    padding-top:16px;
  }

  /* Form side */
  .form-wrap{
    padding:48px;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  .form-wrap h2{
    font-size:22px;
    font-weight:700;
    margin:0 0 6px;
  }
  .form-wrap .sub{
    color:var(--muted);
    font-size:14px;
    margin:0 0 32px;
  }

  form{display:flex; flex-direction:column; gap:20px;}

  .field{
    display:flex;
    flex-direction:column;
    gap:8px;
  }
  .field label{
    font-size:13px;
    color:var(--muted);
  }
  .field input{
    background:var(--bg);
    border:1px solid var(--line);
    border-radius:2px;
    padding:13px 14px;
    color:var(--ink);
    font-family:'Tajawal', sans-serif;
    font-size:15px;
    outline:none;
    transition:border-color .15s ease;
  }
  .field input::placeholder{color:#5C6E68;}
  .field input:focus{
    border-color:var(--gold);
  }
  .field.invalid input{border-color:var(--error);}
  .field .msg{
    font-size:12.5px;
    color:var(--error);
    min-height:16px;
    display:none;
  }
  .field.invalid .msg{display:block;}

  .row-between{
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:13.5px;
  }
  .remember{
    display:flex;
    align-items:center;
    gap:8px;
    color:var(--muted);
  }
  .remember input{accent-color:var(--gold);}
  .row-between a{
    color:var(--gold);
    text-decoration:none;
  }
  .row-between a:hover{text-decoration:underline;}

  button.submit{
    margin-top:8px;
    background:var(--gold);
    color:#171008;
    border:none;
    border-radius:2px;
    padding:14px;
    font-family:'Tajawal', sans-serif;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    transition:filter .15s ease, transform .05s ease;
  }
  button.submit:hover{filter:brightness(1.08);}
  button.submit:active{transform:translateY(1px);}
  button.submit[disabled]{opacity:.6; cursor:default;}

  .status{
    text-align:center;
    font-size:13.5px;
    color:var(--muted);
    min-height:18px;
    margin-top:4px;
  }
  .status.ok{color:#7FB89A;}

  @media (max-width:760px){
    .stage{grid-template-columns:1fr;}
    .side{display:none;}
    .form-wrap{padding:36px 28px;}
  }
</style>
</head>
<body>

<div class="stage">
  <div class="side">
    <div>
      <div class="mark">بوّابة الدخول</div>
      <h1 style="margin-top:28px;">أهلًا بعودتك<br>إلى حسابك</h1>
      <p>أدخل بياناتك في الجانب الآخر للمتابعة إلى لوحة التحكم الخاصة بك.</p>
    </div>
    <div class="foot">محمي ببروتوكول تشفير قياسي. لن نشارك بياناتك مع أي طرف ثالث.</div>
  </div>

  <div class="form-wrap">
    <h2>تسجيل الدخول</h2>
    <p class="sub">مرحبًا بك مجددًا، سعداء برؤيتك</p>

    <form id="loginForm" novalidate>
      <div class="field" id="emailField">
        <label for="email">البريد الإلكتروني</label>
        <input type="email" id="email" placeholder="name@example.com" autocomplete="username">
        <div class="msg">يرجى إدخال بريد إلكتروني صحيح</div>
      </div>

      <div class="field" id="passField">
        <label for="password">كلمة المرور</label>
        <input type="password" id="password" placeholder="••••••••" autocomplete="current-password">
        <div class="msg">كلمة المرور يجب ألا تقل عن ٦ أحرف</div>
      </div>

      <div class="row-between">
        <label class="remember">
          <input type="checkbox" id="remember">
          تذكرني
        </label>
        <a href="#">نسيت كلمة المرور؟</a>
      </div>

      <button type="submit" class="submit" id="submitBtn">دخول</button>
      <div class="status" id="status"></div>
    </form>
  </div>
</div>

<script>
  const form = document.getElementById('loginForm');
  const email = document.getElementById('email');
  const password = document.getElementById('password');
  const emailField = document.getElementById('emailField');
  const passField = document.getElementById('passField');
  const status = document.getElementById('status');
  const btn = document.getElementById('submitBtn');

  function validEmail(v){
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    let ok = true;

    if(!validEmail(email.value.trim())){
      emailField.classList.add('invalid');
      ok = false;
    } else {
      emailField.classList.remove('invalid');
    }

    if(password.value.length < 6){
      passField.classList.add('invalid');
      ok = false;
    } else {
      passField.classList.remove('invalid');
    }

    if(!ok){
      status.textContent = 'يرجى تصحيح الحقول المظللة أعلاه';
      status.classList.remove('ok');
      return;
    }

    // مكان استدعاء API الفعلي لتسجيل الدخول
    btn.disabled = true;
    btn.textContent = 'جارٍ الدخول...';
    status.textContent = '';

    setTimeout(function(){
      btn.disabled = false;
      btn.textContent = 'دخول';
      status.textContent = 'تم تسجيل الدخول بنجاح';
      status.classList.add('ok');
    }, 900);
  });
</script>

</body>
</html>